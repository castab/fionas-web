# Base URL of the fionas-commerce API (server-side only: the browser never calls it, and the
# backend sends no CORS headers). Every backend call goes through the SvelteKit server.
COMMERCE_API_URL=http://localhost:8080

# The admin site's public origin, sent to the API as the `Origin` header on login/logout. It must
# be in the API's trusted-origin list or login fails with a 403 (the server logs a hint).
# Dev: http://localhost:5174   admin-dev: https://admin-dev.fionasicecream.com
# Prod: https://admin.fionasicecream.com
# Leave unset only when the server sees the real public origin (no host rewriting in front of it).
ADMIN_ORIGIN=http://localhost:5174
