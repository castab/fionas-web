# Base URL of the fionas-commerce API (server-side only: the browser never calls it, and the
# backend sends no CORS headers). Every backend call goes through the SvelteKit server, including
# customer payment links (which also need fionas.payment-access.manage granted to the staff role).
COMMERCE_API_URL=http://localhost:8080

# The admin site's public origin, sent to the API as the `Origin` header on login/logout. It must
# be in the API's trusted-origin list or login fails with a 403 (the server logs a hint).
# Dev: http://localhost:5174   admin-dev: https://admin-dev.fionasicecream.com
# Prod: https://admin.fionasicecream.com
# Leave unset only when the server sees the real public origin (no host rewriting in front of it).
ADMIN_ORIGIN=http://localhost:5174

# Encrypts the inquiry-scoped recovery cookies that keep a reviewed Quote/Invoice email's exact
# command (key, message, review token, conversation expectation). At least 32 random characters,
# identical on every admin instance and stable across deploys. Unset: a per-process key, so a
# restart makes unresolved sends unrecoverable here (fail closed). See docs/admin-financial-emails.md.
ADMIN_RECOVERY_SECRET=
