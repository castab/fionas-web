# Base URL of the fionas-commerce API (server-side only; the backend sends no CORS headers).
# Same variable as apps/admin.
COMMERCE_API_URL=http://localhost:8080

# This site's SERVICE identity at fionas-commerce (SERVICE:fionas-web, role fionas.web). The server
# exchanges them at POST /auth/service/token for a short-lived access token, kept in memory and
# sent as "Authorization: Bearer" on GET /inquiry-form, POST /estimate-preview and POST /inquiries.
# Both come from `npm run provision:service` (see README.md, "Service authentication"), which
# writes them here and then makes this file owner-only (0600) on Linux/macOS; the secret is shown
# only once, when the credential is created. They are NOT the backend's
# SERVICE_TOKENS_SIGNING_KEY, which this app never has.
# Needed only while BOOKING_ENABLED=true; without them /book shows its "unavailable" page.
# Keep real values in your git-ignored .env (or the host's secret store) only. Read only by
# src/lib/server/; they never reach the browser (see docs/public-inquiry-submission.md).
COMMERCE_SERVICE_ID=
COMMERCE_SERVICE_CREDENTIAL=

# Set to "true" to enable /book and link the "Book" CTAs to it (hides the "Booking late 2026"
# badge). Unset/false: /book returns 404 and the CTAs show the coming-soon toast.
BOOKING_ENABLED=false
