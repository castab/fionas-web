# NATS + JetStream that /book publishes InquirySubmitted events to (server-side only; see
# asyncapi.yaml and docs/public-inquiry-submission.md). One URL, or several comma-separated for a
# cluster. Locally, `npm run nats:up` starts one from compose.yaml and creates the stream.
# Needed only while BOOKING_ENABLED=true; without it a submission shows the "unavailable" message.
NATS_URL=nats://127.0.0.1:4222

# How this site authenticates: a .creds file (decentralized JWT auth, preferred in production)...
NATS_CREDS_FILE=
# ...or a preshared token (e.g. deployed development). Precedence: creds file, token, user/password.
NATS_TOKEN=
# ...or a user and password. The values below are the local compose server's dev-only web user
# (infra/nats/nats-server.conf), which may publish only fionas.inquiries.submitted.v1.
# Keep real values in your git-ignored .env (or the host's secret store) only. Read only by
# src/lib/server/nats.ts; they never reach the browser and are never logged.
NATS_USER=fionas-web
NATS_PASSWORD=fionas-web-dev

# Set to "true" to enable /book and link the "Book" CTAs to it (hides the "Booking late 2026"
# badge). Unset/false: /book returns 404 and the CTAs show the coming-soon toast.
BOOKING_ENABLED=false

# Price amounts only, in an ignored YAML file
FIONAS_PRICES_FILE=
# ...or the entire YAML pasted inline (quote the multi-line value). Overrides FIONAS_PRICES_FILE
# when non-blank; if it is set but invalid, booking is unavailable (no fallback to the file).
FIONAS_PRICES_YML=
# Separate random signing secret, at least 32 bytes; stable across replicas
FIONAS_REPLAY_SECRET=

# Server-only presentation service: gallery reads and view/click tracking.
PRESENTATION_SERVICE_BASE_URL=
PRESENTATION_SERVICE_ACCOUNT_ID=
PRESENTATION_SERVICE_GALLERY_NAME=
PRESENTATION_SERVICE_TRACKING_TOKEN=

# Cloudflare Turnstile (managed widget; restrict allowed hostnames in Cloudflare).
# Both required while booking is enabled; only the site key reaches the browser.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
