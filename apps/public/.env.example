# Base URL of the fionas-commerce API (server-side only; the backend sends no CORS headers).
COMMERCE_API_URL=http://localhost:8080

# Trusted server-side UI key for the commerce API, sent as "Authorization: Bearer <key>" on
# GET /inquiry-form, POST /estimate-preview and POST /inquiries. Without it those calls return
# 401 and /book shows its "unavailable" page. Keep it in your real .env only: never commit it.
# Read only by src/lib/server/commerce.ts; it never reaches the browser
# (see docs/public-inquiry-submission.md).
COMMERCE_UI_API_KEY=

# Set to "true" to enable /book and link the "Book" CTAs to it (hides the "Booking late 2026"
# badge). Unset/false: /book returns 404 and the CTAs show the coming-soon toast.
BOOKING_ENABLED=false
