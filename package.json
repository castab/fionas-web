{
	"name": "fionas-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "26.9.0"
	},
	"workspaces": [
		"packages/*",
		"apps/*",
		"scripts"
	],
	"scripts": {
		"dev": "npm run dev --workspace=@fionas/public",
		"dev:admin": "npm run dev --workspace=@fionas/admin",
		"nats:up": "docker compose up --detach --wait nats && node scripts/nats-setup.mjs",
		"nats:down": "docker compose down",
		"nats:setup": "node scripts/nats-setup.mjs",
		"nats:tail": "node scripts/nats-tail.mjs",
		"asyncapi:validate": "node scripts/validate-asyncapi.mjs",
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "npm run test:unit --workspaces --if-present --",
		"test:e2e": "npm run test:e2e --workspaces --if-present",
		"test": "npm run test:unit -- --run && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.1"
	}
}
